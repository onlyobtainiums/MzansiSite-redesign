# ═══════════════════════════════════════════════════════════════════════════
#  MzansiSite — environment variables
#
#  This app uses TWO services, and they do different jobs:
#
#    • Supabase (Postgres)  → stores your app's data: sites, services,
#                             subscriptions, payments, leads  (src/db/schema.ts)
#    • Firebase (Auth)      → handles sign-in / identity only. The users table
#                             mirrors the Firebase uid so data has an owner.
#
#  You need BOTH. Firebase alone cannot store the site/billing data, and
#  Postgres alone cannot sign anyone in.
#
#  Set every variable below in Vercel → Settings → Environment Variables
#  (Production AND Preview), then redeploy.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database (Supabase) ───────────────────────────────────────────────────
# Supabase dashboard → your project → Connect (top bar) → Connection string
#
# Use the TRANSACTION POOLER string (port 6543) for the app. Vercel runs many
# short-lived serverless instances, and the pooler stops them exhausting your
# database's connection limit. The direct connection (db.<ref>.supabase.co)
# is IPv6-only and will fail on Vercel.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
DATABASE_URL=

# Used only for schema changes (`npm run db:push`). Must be the SESSION pooler
# or direct connection (port 5432), because the transaction pooler cannot run
# the multi-statement DDL that migrations need.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Optional — if omitted, DATABASE_URL is used instead.
DIRECT_URL=

# ─── Customer site subdomains ──────────────────────────────────────────────
# Published sites are served at <slug>.<this domain>, routed by src/proxy.ts.
# Only needed if the domain ever changes — the fallback is mzansisite.co.za.
# In Vercel, add all three to Project → Settings → Domains:
#     mzansisite.co.za        (apex)
#     www.mzansisite.co.za
#     *.mzansisite.co.za      (wildcard — serves every customer subdomain)
# A wildcard domain requires Vercel's nameservers, because wildcard SSL
# certificates are issued via DNS-01 validation.
NEXT_PUBLIC_ROOT_DOMAIN=mzansisite.co.za

# ─── Firebase Auth ─────────────────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app config
# These are NEXT_PUBLIC_ so the browser can reach Firebase Auth directly.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side token verification — Firebase console → Project settings →
# Service accounts → "Generate new private key". Paste the values from the
# downloaded JSON. Keep the \n escapes in FIREBASE_PRIVATE_KEY; both
# "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" (single
# line with \n) and a real multi-line value are handled.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Payments (optional) ───────────────────────────────────────────────────
# The app runs without these; the "Publish" button just stays disabled.
# https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
# Create the plan once: POST https://api.paystack.co/plan
#   { "name": "MzansiSite Monthly", "interval": "monthly", "amount": 14999, "currency": "ZAR" }
PAYSTACK_PLAN_CODE=

# ─── Analytics (optional) ────────────────────────────────────────────────
# GA4 Measurement ID — public, not a secret. Set in Vercel → Settings →
# Environment Variables (Production + Preview). Verified ID: G-W3123L8FLP
# The app renders GA4 via @next/third-parties/google only when this is set
# (falls back to G-W3123L8FLP if missing). No PII or payment data is sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-W3123L8FLP

# ─── Image uploads (optional) ──────────────────────────────────────────────
# The app runs without these; logo/gallery uploading stays disabled.
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
