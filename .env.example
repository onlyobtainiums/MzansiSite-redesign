# ——— Core (already configured) ———
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ——— Cloudinary (Stage 5 — image uploads) ———
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ——— Paystack (Stage 6 — R149.99/month subscriptions) ———
# https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
# Create the plan once: POST https://api.paystack.co/plan
# { "name": "MzansiSite Monthly", "interval": "monthly", "amount": 14999, "currency": "ZAR" }
PAYSTACK_PLAN_CODE=PLN_xxxxxxxxx
# Webhook secret (same as PAYSTACK_SECRET_KEY unless overridden):
PAYSTACK_WEBHOOK_URL=https://yourdomain.co.za/api/paystack/webhook

# ——— Firebase Auth (Stage 4 — customer accounts) ———
# https://console.firebase.google.com → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side token verification: Project settings → Service accounts →
# "Generate new private key" (paste values below; keep the \n escapes in the key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
